{% capture jbcache %}
  <!--
  - Dynamically set liquid variables for working with URLs/paths
  -->
  {% if site.JB.setup.provider == "custom" %}
    {% include custom/setup %}
  {% else %}
    {% comment %}
      BASE_PATH comes from site.baseurl, not from site.JB.BASE_PATH. JB only
      read its own setting when site.safe was true, which is not how the site
      is built any more — so every link the JB includes generate
      (posts_collate, pagination, tags_line and the rest) came out unprefixed
      while everything using site.baseurl was correct. One variable now drives
      both. Empty in production, so nothing changes there.
    {% endcomment %}
    {% if site.baseurl and site.baseurl != '' %}
      {% assign BASE_PATH = site.baseurl %}
      {% assign HOME_PATH = site.baseurl %}
    {% else %}
      {% assign BASE_PATH = nil %}
      {% assign HOME_PATH = "/" %}
    {% endif %}

    {% if site.JB.ASSET_PATH %}
      {% assign ASSET_PATH = site.JB.ASSET_PATH %}
    {% else %}
      {% capture ASSET_PATH %}{{ BASE_PATH }}/assets/themes/{{ layout.theme.name }}{% endcapture %}
    {% endif %}
  {% endif %}
{% endcapture %}{% assign jbcache = nil %}